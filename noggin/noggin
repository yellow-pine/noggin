#!/bin/sh
# Talk to the noggin service socket.
[ $# -gt 0 ] || { cat >&2 <<'USAGE'
usage: noggin on|off                     mute / unmute
       noggin eureka|attention|bored|wince <1-3>
       noggin wink 1|2|3                 slow wink: 1 your right lid, 2 your left, 3 random
       noggin thinking|rest              background mode
       noggin release                    unpower the servos (they slump); any command re-powers
       noggin pose lids <0-1> [eyes <angle>]   hold a pose (eyes 90 = straight)
       noggin set <key> <value>          live calibration, saved to eyes/calibration.json
       noggin reload                     resend eyes/calibration.json to the Core
       noggin exercise <minutes>         gentle run-in cycling, mid-range only
       noggin demo [once]                loop every gesture, 5 s apart, hooks ignored (once: one round, then follow)
       noggin demo <gesture> [level]     repeat one gesture, 5 s apart, for tuning
       noggin follow                     back to reacting to Claude Code (the mode after any restart)
       noggin status                     per Core: wifi <ip> uptime / usb <port> / offline; then the mode
USAGE
exit 2; }
printf '%s\n' "$*" | nc -U -w 1 "$HOME/.noggin.sock" || { echo "noggin not running (make start)" >&2; exit 1; }
