{
  "permissions": {
    "deny": [
      "Bash(git stash *)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh pr merge --admin*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push * :main*)",
      "Bash(just check *)",
      "Bash(just check-all *)",
      "Bash(just hero *)",
      "Bash(just pictures *)",
      "Bash(just render *)",
      "Bash(just sim *)",
      "Bash(just test *)",
      "Bash(just trajectories *)",
      "Bash(just view *)",
      "Bash(just web *)",
      "Bash(uv run just check *)",
      "Bash(uv run just check-all *)",
      "Bash(uv run just hero *)",
      "Bash(uv run just pictures *)",
      "Bash(uv run just render *)",
      "Bash(uv run just sim *)",
      "Bash(uv run just test *)",
      "Bash(uv run just trajectories *)",
      "Bash(uv run just view *)",
      "Bash(uv run just web *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sync_checkout.py" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sync_checkout.py" }]
      }
    ]
  }
}
