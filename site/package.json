{
  "name": "noggin-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prebuild": "mkdir -p public/viewer/draco && cp node_modules/three/examples/jsm/libs/draco/gltf/draco_wasm_wrapper.js node_modules/three/examples/jsm/libs/draco/gltf/draco_decoder.wasm public/viewer/draco/",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "smoke": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/starlight": "^0.42.8",
    "@fontsource/rubik": "^5.3.0",
    "astro": "^7.4.4",
    "astro-mermaid": "^2.2.0",
    "github-slugger": "^2.0.0",
    "mermaid": "^12.2.0",
    "starlight-github-alerts": "^0.5.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "@playwright/test": "^1.64.1",
    "node-html-parser": "^9.0.6",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "fsevents": false,
    "puppeteer": false
  },
  "//": "shortcut: mermaid-cli 12.0.0 pins katex ^0.16 (GHSA-238p-pmpm-9mq7, fixed in 0.18.2) and reads only its katex/dist/katex.css, so overrides lifts it to 0.18; drop once mermaid-cli moves to katex 0.18.",
  "overrides": {
    "@mermaid-js/mermaid-cli": {
      "katex": "^0.18.2"
    }
  }
}
