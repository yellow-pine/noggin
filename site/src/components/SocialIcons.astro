---
// Starlight's social links, after the newest release's tag, which labels the docs (docs/adr/0021), and the repo's live
// stars and forks (api.github.com, asked by the reader's browser).
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import { REPO } from '../pages.mjs';

const API = REPO.replace('github.com', 'api.github.com/repos');
---

<a class="docs-version" data-api={`${API}/releases/latest`} hidden></a>
<a class="repo-facts" href={REPO} data-api={API} aria-label="Stars and forks on GitHub" hidden></a>
<Default />

<script>
  // the header's and the mobile menu's
  const versions = document.querySelectorAll<HTMLAnchorElement>('.docs-version');
  const facts = document.querySelector<HTMLAnchorElement>('.repo-facts')!;
  const get = (a: HTMLAnchorElement) => fetch(a.dataset.api!).then((r) => (r.ok ? r.json() : null));
  const [release, repo] = await Promise.all([get(versions[0]), get(facts)]);
  for (const v of release ? versions : []) {
    v.textContent = `${release.tag_name} (latest)`;
    v.href = release.html_url;
    v.hidden = false;
  }
  if (repo) {
    facts.textContent = `★ ${repo.stargazers_count} · ⑂ ${repo.forks_count}`;
    facts.hidden = false;
  }
</script>

<style>
  .docs-version, .repo-facts { color: var(--sl-color-gray-2); font-size: var(--sl-text-sm); text-decoration: none; white-space: nowrap; }
</style>
