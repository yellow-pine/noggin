---
// The header's Theme bar (#806, #819, docs/adr/0022), then Starlight's colour scheme select: one labelled select of the
// model's Presets (src/theme.mjs, from model/geometry.py PRESETS), so a new Preset needs no edit here. A pick (the
// address's or the reader's last; none by default, #883) goes on <html> as data-preset, into the address
// (?preset=default-build) and local storage, and to the viewer (a noggin-theme event); css() shows each page's
// pictures and text for it alone. In the header and in the mobile menu: both bars stay in step.
import Default from '@astrojs/starlight/components/ThemeSelect.astro';
import { PRESETS, css } from '../theme.mjs';
---

<div class="noggin-theme" role="group" aria-label="Theme">
  <label>
    <span>Preset</span>
    <select autocomplete="off">
      {Object.entries(PRESETS).map(([slug, p]) => <option value={slug}>{p.label}</option>)}
    </select>
  </label>
</div>
<Default />

<Fragment set:html={`<style>${css()}</style>`} />

<script>
  import { picked } from '../theme.mjs';

  // shortcut: the Preset applies once this module runs, so a page in a picked Preset draws the default's for a moment;
  // an is:inline script in the head would hide it if it shows
  const KEY = 'noggin-preset', root = document.documentElement;
  const selects = document.querySelectorAll<HTMLSelectElement>('.noggin-theme select');
  const stored = () => {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null; // no storage (a private window, blocked site data): the default
    }
  };

  function apply(preset: string) {
    const link = new URLSearchParams(location.search);
    root.dataset.preset = preset;
    link.set('preset', preset);
    for (const s of selects) s.value = preset;
    history.replaceState(history.state, '', `${location.pathname}?${link}${location.hash}`);
    try {
      localStorage.setItem(KEY, preset);
    } catch {
      // the pick holds on this page and in its address alone
    }
  }

  const first = picked(location.search, stored()); // none picked: the default's pages, the viewer's own mix (#883)
  if (first) apply(first);
  for (const s of selects)
    s.addEventListener('change', () => {
      apply(s.value);
      document.dispatchEvent(new Event('noggin-theme'));
    });
</script>

<style>
  .noggin-theme { display: flex; gap: 0.75rem; align-items: center; }
  .noggin-theme label { display: flex; gap: 0.35rem; align-items: center; color: var(--sl-color-gray-2); font-size: var(--sl-text-sm); }
  .noggin-theme select {
    font: inherit; color: var(--sl-color-white); background: var(--sl-color-black); cursor: pointer;
    border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; padding: 0.15rem 0.35rem;
  }
  .noggin-theme select:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 1px; }
</style>
