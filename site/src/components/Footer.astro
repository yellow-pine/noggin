---
// Starlight's footer, then the site's version (pyproject.toml) linking its release, or the releases before it, and
// the commit it was built from (macros.py build, #372); and the web viewer (docs/adr/0008) on any page that has a
// <div class="noggin-viewer">: its module and three.js load only there, and under a poster (the home page's hero GIF,
// #468) only once it is in view, or on a phone on a tap of Play in 3D.
import Default from '@astrojs/starlight/components/Footer.astro';
import { build, released } from '../macros.json';
import { REPO } from '../pages.mjs';

const release = released ? `${REPO}/releases/tag/v${build.version}` : `${REPO}/releases`;
---

<Default />
<p class="noggin-version">
  noggin <a href={release}>v{build.version}</a> · <a href={`${REPO}/commit/${build.commit}`}>{build.commit.slice(0, 7)}</a>
</p>

<script>
  // shortcut: the page's first viewer decides for all; a page with two viewers, one with a poster, needs one each
  const viewer = document.querySelector('.noggin-viewer');
  const load = () => import('../viewer/viewer.mjs');
  if (viewer && !viewer.querySelector('figure')) load();
  else if (viewer && matchMedia('(max-width: 50rem)').matches) {
    const play = viewer.appendChild(document.createElement('button'));
    play.textContent = 'Play in 3D';
    play.addEventListener('click', () => (play.remove(), load()));
  } else if (viewer)
    new IntersectionObserver(([seen], o) => seen.isIntersecting && (o.disconnect(), load())).observe(viewer);
</script>

<style>
  .noggin-version { color: var(--sl-color-gray-3); font-size: var(--sl-text-xs); text-align: center; }
  .noggin-version a { color: inherit; }
</style>
