---
// Starlight's footer, then "by Yellow Pine" with the brand's logo (yellow-pine/.github brand/, v2.2: the light theme's
// and the dark's, #603), the site's version (the git tag) linking its release, or the releases before it, and
// the commit it was built from (macros.py build, #372); an old Docs version's URL on to the docs (docs/adr/0021); and
// the web viewer (docs/adr/0008) on any page that has a <div class="noggin-viewer">: its module and three.js load only
// there, once a viewer is scrolled into view (#839).
import Default from '@astrojs/starlight/components/Footer.astro';
import { build, released } from '../macros.json';
import { REPO } from '../pages.mjs';
import logo from '../assets/yellow-pine.svg';
import logoDark from '../assets/yellow-pine-dark.svg';

const release = released ? `${REPO}/releases/tag/v${build.version}` : `${REPO}/releases`;
---

<Default />
<a class="noggin-credit" href="https://yellowpine.com/">
  by
  <img class="noggin-light" src={logo.src} alt="Yellow Pine" width="110" height="20" />
  <img class="noggin-dark" src={logoDark.src} alt="Yellow Pine" width="110" height="20" />
</a>
<p class="noggin-version">
  noggin <a href={release}>v{build.version}</a> · <a href={`${REPO}/commit/${build.commit}`}>{build.commit.slice(0, 7)}</a>
</p>

<script>
  // an old Docs version's URL (/noggin/vX.Y/…, gone since docs/adr/0021) reaches only the 404 page: on to the same
  // page in the docs, or to their home when it is gone too
  const home = import.meta.env.BASE_URL.replace(/\/$/, '');
  const old = location.pathname.match(new RegExp(`^${home}/v\\d+\\.\\d+(?:\\.\\d+)?(/.*)?$`));
  if (old) {
    const now = `${home}${old[1] ?? '/'}`;
    fetch(now, { method: 'HEAD' }).then((r) => location.replace(r.ok ? now : `${home}/`));
  }

  const seen = new IntersectionObserver((entries, o) => {
    if (entries.some((e) => e.isIntersecting)) o.disconnect(), import('../viewer/viewer.mjs');
  });
  document.querySelectorAll('.noggin-viewer').forEach((v) => seen.observe(v));
</script>

<style>
  .noggin-credit {
    display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-top: 2.5rem;
    color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); text-decoration: none;
  }
  .noggin-credit img { height: 1.1rem; width: auto; }
  :global([data-theme='light']) .noggin-dark, :global([data-theme='dark']) .noggin-light { display: none; }
  .noggin-version { color: var(--sl-color-gray-3); font-size: var(--sl-text-xs); text-align: center; }
  .noggin-version a { color: inherit; }
</style>
