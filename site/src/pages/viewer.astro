---
// The web viewer's page (docs/adr/0008) in the site's theme: the viewer (loaded by src/components/Footer.astro), which
// draws the next Mech's GLB beside this page at viewer/ (web/build.py PUBLIC, docs/adr/0019, #649) and moves these
// head variant buttons (macros.py variants, from model/geometry.py NEXT and just sim's ranking) into its bar (#664, #686).
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { published } from '../macros.json';

const { ranked, buttons } = published.variants;
---

<StarlightPage frontmatter={{ title: 'Viewer', tableOfContents: false }}>
  <p>
    {`The next Mech as its model has it so far, per head variant${ranked ? ', best first in the ranking of their sim reports' : ''}: `}
    {buttons.map((b) => `${b.label}, ${b.about}`).join('; ')}. Drag to turn it, scroll or pinch to zoom, play each gesture
    and take it apart.
  </p>
  <div class="noggin-viewer" data-stage={buttons[0].glb} data-zoom>
    <nav aria-label="Head">
      <span>Head</span>
      {buttons.map((b) => <button data-stage={b.glb}>{b.label}</button>)}
    </nav>
  </div>
</StarlightPage>

<style is:global>
  .noggin-viewer canvas { height: 60vh; } /* the bar under it in view on a laptop */
</style>
