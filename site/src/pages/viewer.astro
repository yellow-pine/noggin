---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---
<StarlightPage frontmatter={{ title: 'Viewer', tableOfContents: false }}>
  <canvas id="view" width="640" height="400" style="width:100%"></canvas>
  <p id="status">loading</p>
</StarlightPage>
<script>
  import * as THREE from 'three';
  import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
  import { DRACOLoader } from 'three/examples/jsm/loaders/DRACOLoader.js';

  const canvas = document.getElementById('view') as HTMLCanvasElement;
  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
  const scene = new THREE.Scene();
  scene.add(new THREE.HemisphereLight(0xffffff, 0x444444, 3));
  const camera = new THREE.PerspectiveCamera(45, canvas.width / canvas.height, 0.01, 1000);
  const draco = new DRACOLoader().setDecoderPath(`${import.meta.env.BASE_URL}/draco/`);
  const gltf = await new GLTFLoader().setDRACOLoader(draco).loadAsync(`${import.meta.env.BASE_URL}/models/duck.glb`);
  scene.add(gltf.scene);
  const box = new THREE.Box3().setFromObject(gltf.scene);
  const c = box.getCenter(new THREE.Vector3()), s = box.getSize(new THREE.Vector3()).length();
  camera.position.copy(c).add(new THREE.Vector3(s, s * 0.5, s));
  camera.lookAt(c);
  renderer.render(scene, camera);
  document.getElementById('status')!.textContent = `loaded ${gltf.scene.children.length} node(s)`;
</script>
