---
// The web viewer's page (docs/adr/0008) in the site's theme: the viewer (loaded by src/components/Footer.astro), which
// draws the Stage's GLB beside this page at viewer/ and moves these Stage buttons (macros.py, from model/geometry.py
// STAGES), a segmented 1 2 3, into its bar.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { stages } from '../macros.json';
---

<StarlightPage frontmatter={{ title: 'Viewer', tableOfContents: false }}>
  <p>
    The Mech that reacts to Claude Code, as built in its model. Drag to turn it, scroll or pinch to zoom, play each
    gesture and take Stage 3 apart.
  </p>
  <div class="noggin-viewer" data-stage={stages.at(-1)}>
    <nav aria-label="Stage">
      <span>Stage</span>
      {stages.map((stage, n) => <button data-stage={stage} aria-label={`Stage ${n + 1}`}>{n + 1}</button>)}
    </nav>
  </div>
</StarlightPage>

<style is:global>
  .noggin-viewer canvas { height: 60vh; } /* the bar under it in view on a laptop */
</style>
