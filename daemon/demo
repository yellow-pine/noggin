#!/bin/sh
# Play every gesture twice, printing its name as it starts. Run from the repo: daemon/demo
cd "$(dirname "$0")/.."
play() { printf '%-14s %s\n' "$1" "$2"; daemon/noggin $1; sleep "$3"; }
for round in 1 2; do
  echo "--- round $round"
  play "eureka 1"    "quick reply: glance + blink"          5
  play "eureka 2"    "normal: dart aside, back, double blink" 6
  play "eureka 3"    "long grind: + double-take"            7
  play "attention 2" "needs you: half lids, real scan"      7
  play "bored 2"     "you left: droop, heavy blinks, long close" 11
  play "wince 2"     "error: shut, twitch, reopen"          5
  play "wink 3"      "hello: slow one-lid wink"             4
  play "thinking"    "mid-turn: averted gaze, micro-saccades" 8
  play "rest"        "idle: still"                          3
done
